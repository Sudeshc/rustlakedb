# RustLakeDB v0.1.0 Core Declarative SQL Logic Tests (SLT)

statement ok
CREATE TABLE metrics (id BIGINT, service TEXT, latency DOUBLE, payload JSONB)

statement ok
INSERT INTO metrics VALUES (1, 'auth', 12.5, '{"env": "prod", "ok": true}'), (2, 'auth', 17.5, '{"env": "prod", "ok": true}')

statement ok
INSERT INTO metrics VALUES (3, 'billing', 45.0, '{"env": "prod", "ok": false}'), (4, 'billing', 5.0, '{"env": "staging", "ok": true}')

query
SELECT service, COUNT(*) AS cnt, SUM(latency) AS total_ms, MIN(latency) AS min_ms, MAX(latency) AS max_ms FROM metrics WHERE payload->>'env' = 'prod' GROUP BY service ORDER BY service
----
auth|2|30|12.5|17.5
billing|1|45|45|45

# JSON path extraction in SELECT and GROUP BY
query
SELECT payload->>'env' AS env, COUNT(*) AS cnt FROM metrics GROUP BY payload->>'env' ORDER BY env
----
prod|3
staging|1

# HAVING + DISTINCT + LIKE + IN
query
SELECT service, SUM(latency) AS total_ms FROM metrics WHERE service IN ('auth', 'billing') AND service LIKE '%i%' GROUP BY service HAVING total_ms > 40
----
billing|50

query
SELECT DISTINCT service FROM metrics ORDER BY service
----
auth
billing

# Iceberg v3 UPDATE (DV + append) & DELETE (DV)
statement ok
UPDATE metrics SET latency = 20.0 WHERE id = 1

statement ok
DELETE FROM metrics WHERE id = 2

query
SELECT service, COUNT(*) AS cnt, AVG(latency) AS avg_ms FROM metrics WHERE payload->>'env' = 'prod' GROUP BY service ORDER BY service
----
auth|1|20
billing|1|45

# Iceberg Schema Evolution (ALTER TABLE ADD COLUMN -> NULL on older Parquet files)
statement ok
ALTER TABLE metrics ADD COLUMN region TEXT

statement ok
INSERT INTO metrics VALUES (5, 'search', 8.0, '{"env": "prod"}', 'us-west')

query
SELECT id, region FROM metrics WHERE region IS NOT NULL
----
5|us-west

query
SELECT id, service FROM metrics ORDER BY latency DESC LIMIT 2
----
3|billing
1|auth

# LEFT JOIN preserving unmatched rows
statement ok
CREATE TABLE owners (service TEXT, team TEXT)

statement ok
INSERT INTO owners VALUES ('auth', 'security')

query
SELECT service, team FROM metrics LEFT JOIN owners ON metrics.service = owners.service WHERE id IN (1, 3) ORDER BY service
----
auth|security
billing|NULL
